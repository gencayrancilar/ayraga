# ═══════════════════════════════════════════════════════════════════════
# AYRA · ortam değişkenleri
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
#   cp .env.example .env.local
# .env.local asla sürüm kontrolüne girmez.
# ═══════════════════════════════════════════════════════════════════════

# ── Veritabanı ─────────────────────────────────────────────────────────
# Supabase: Project Settings → Database → Connection string → URI
# Migration'lar için doğrudan bağlantıyı (port 5432) kullanın.
DATABASE_URL="postgresql://postgres:PAROLA@db.PROJE_REF.supabase.co:5432/postgres"

# ── Oturum ─────────────────────────────────────────────────────────────
# En az 32 karakter. Üretmek için:  openssl rand -base64 48
# AUTH_PROVIDER=local: oturumları AYRA kendi imzalar (Supabase Auth gerekmez).
# AUTH_PROVIDER=supabase: Supabase Auth kullanılır; bu değer projenin
# JWT Secret'ı olmalıdır.
AUTH_PROVIDER="local"
AUTH_JWT_SECRET="buraya-en-az-32-karakterlik-rastgele-bir-anahtar-yazin"

# ── Depolama ───────────────────────────────────────────────────────────
# local    : görseller sunucudaki storage/uploads klasörüne yazılır
# supabase : Supabase Storage kullanılır (aşağıdaki dört değer gerekir)
# NOT: sunucu ve tarayıcı ayrı değişken okur; ikisini birlikte ayarlayın.
STORAGE_PROVIDER="local"
NEXT_PUBLIC_STORAGE_PROVIDER="local"

# ── Site ───────────────────────────────────────────────────────────────
# Paylaşım kartlarını, site haritasını ve kanonik adresleri belirler.
# Yayına çıkarken gerçek alan adına ayarlayın.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Harita ─────────────────────────────────────────────────────────────
# Açılış konumu: Ayrancılar, Torbalı / İzmir
NEXT_PUBLIC_DEFAULT_LAT="38.24083"
NEXT_PUBLIC_DEFAULT_LNG="27.27861"
NEXT_PUBLIC_DEFAULT_ZOOM="14"
# İsteğe bağlı: farklı bir MapLibre stili (varsayılan OpenFreeMap, anahtarsız)
# NEXT_PUBLIC_MAP_STYLE="https://tiles.openfreemap.org/styles/positron"


# ═══════════════════════════════════════════════════════════════════════
# Supabase Storage kullanacaksanız
# Storage → New bucket → ad: report-media → Public bucket: açık
# ═══════════════════════════════════════════════════════════════════════
# STORAGE_PROVIDER="supabase"
# NEXT_PUBLIC_STORAGE_PROVIDER="supabase"
# NEXT_PUBLIC_SUPABASE_URL="https://PROJE_REF.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."          # yalnızca sunucu tarafı, gizli
# SUPABASE_STORAGE_BUCKET="report-media"
# NEXT_PUBLIC_SUPABASE_BUCKET="report-media"
