# Bağımlılıklar
/node_modules

# Derleme çıktısı
/.next
/out
next-env.d.ts
tsconfig.tsbuildinfo

# Ortam dosyaları ve sırlar
# vercel-env.txt gerçek veritabanı bağlantısını ve servis anahtarını taşır;
# .env.example ise yalnızca örnek değerler içerdiği için izlenir.
.env*
!.env.example
vercel-env.txt
vercel-env-aktar.sh
/.vercel

# Kullanıcı yüklemeleri ve veritabanı yedekleri — kaynak kodu değil.
# Yedek dosyaları bütün bildirimleri, profilleri ve e-posta adreslerini
# taşır; depoya asla girmemeli. Betiğin varsayılan klasörü "yedek".
/storage
/yedek
/yedekler
*.json.gz

# Kurulum sırasında üretilen geçici paketler
/_kurulum/*.zip
/_kurulum/*.tar.gz

# İşletim sistemi
.DS_Store
